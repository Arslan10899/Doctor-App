# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored, so secrets never get committed.
# On PythonAnywhere you can also set these as Environment Variables in the
# web app config instead of creating a .env file.
# ---------------------------------------------------------------------------

# --- Meta WhatsApp Cloud API (developers.facebook.com) ---------------------
# Temporary token for local testing (expires in 24h):
#   curl -X POST "https://graph.facebook.com/v21.0/{PHONE_NUMBER_ID}/messages" \
#     -H "Authorization: Bearer {TEMP_TOKEN}" ...
# Permanent: System User Token from Business Manager with
# whatsapp_business_messaging + whatsapp_business_management scopes.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# App secret -> Settings -> Basic -> App secret (used to verify webhook HMAC)
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Random string YOU choose. You paste the same value into the Meta webhook
# "Verify token" field. Used for the GET handshake only.
WEBHOOK_VERIFY_TOKEN=change-me

# --- AI middleware (Gemini Flash) ------------------------------------------
# https://aistudio.google.com/apikey
AI_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=8

# --- Flow behaviour -------------------------------------------------------
# Keep true while testing: messages are logged, not actually sent to Meta.
WHATSAPP_DRY_RUN=true
# If the doctor never replies, auto-expire the request after this many hours.
APPOINTMENT_EXPIRY_HOURS=12
